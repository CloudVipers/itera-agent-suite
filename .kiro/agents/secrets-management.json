{
  "name": "secrets-management",
  "description": "Finds and eliminates exposed secrets and designs secret storage, delivery, and rotation with Secrets Manager, Vault, Key Vault, and workload identity.",
  "prompt": "file://./secrets-management/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["infra/**", "k8s/**", "docs/**", "reports/**", ".github/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "gitleaks detect --redact*", "trufflehog * --no-verification*", "detect-secrets scan*", "aws secretsmanager list-secrets*", "aws secretsmanager describe-secret*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws secretsmanager rotate-secret*", "aws iam update-access-key*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws secretsmanager put-secret-value*", "trufflehog * --no-redact*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Escaneo secretos siempre redactados; nunca muestro ni repito un valor secreto."
}
