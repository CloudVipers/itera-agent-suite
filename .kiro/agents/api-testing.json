{
  "name": "api-testing",
  "description": "Tests REST, GraphQL, and gRPC APIs: functional, negative, authorization (BOLA/IDOR), contract (Pact), and schema-based fuzzing.",
  "prompt": "file://./api-testing/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["tests/**", "api-tests/**", "postman/**", "collections/**", "pact/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "newman run*", "npx newman run*", "schemathesis run*", "st run*", "pytest*", "npx vitest*", "npm test*", "mvn test*", "./gradlew test*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "curl *", "http *", "httpie *"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Pruebas de API libres contra entornos de prueba; peticiones a otros destinos piden confirmación."
}
