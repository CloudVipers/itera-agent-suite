{
  "name": "smart-contract-security",
  "description": "Audits Solidity/EVM smart contracts: reentrancy, access control, oracle and flash-loan attacks, upgradeability, with Slither, Foundry fuzzing, and PoCs.",
  "prompt": "file://./smart-contract-security/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["src/**", "contracts/**", "test/**", "audits/**", "reports/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "forge build*", "forge test*", "forge coverage*", "forge fmt --check*", "slither *", "aderyn *", "echidna *", "medusa fuzz*", "npx hardhat compile*", "npx hardhat test*", "solhint *"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "anvil*", "forge script*", "npx hardhat run*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "forge script * --broadcast*", "cast send*", "npx hardhat run * --network mainnet*", "cast wallet *"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Auditoría con pruebas locales; desplegar o enviar transacciones a redes reales está bloqueado."
}
