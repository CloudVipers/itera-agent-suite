{
  "name": "android-developer",
  "description": "Builds and reviews Android apps with Kotlin and Jetpack Compose: architecture, coroutines/Flow, Room, WorkManager, security, and Play readiness.",
  "prompt": "file://./android-developer/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["ios/**", "android/**", "lib/**", "src/**", "app/**", "test/**", "tests/**", "docs/**", "**/*.kt", "**/build.gradle.kts", "gradle/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "./gradlew lint*", "./gradlew test*", "./gradlew assembleDebug*", "./gradlew detekt*", "./gradlew ktlintCheck*", "adb devices*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "./gradlew connectedAndroidTest*", "./gradlew bundleRelease*", "fastlane *"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "fastlane supply*", "./gradlew publish*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Gradle lint y tests libres; publicar en Play Store está bloqueado."
}
