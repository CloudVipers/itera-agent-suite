{
  "name": "kafka-streaming",
  "description": "Designs and operates Apache Kafka (MSK, Confluent, Redpanda): topics and partitions, durable producers, idempotent consumers, schemas, and stream processing.",
  "prompt": "file://./kafka-streaming/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["schemas/**", "src/**", "infra/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws kafka describe-*", "aws kafka list-*", "kafka-topics.sh --describe*", "kafka-topics.sh --list*", "kafka-consumer-groups.sh --describe*", "kcat -L*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "kafka-topics.sh --create*", "kafka-topics.sh --alter*", "kafka-configs.sh --alter*", "kafka-consumer-groups.sh --reset-offsets*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "kafka-topics.sh --delete*", "aws kafka delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Lectura del clúster libre; crear o modificar topics pide confirmación y borrar está bloqueado."
}
