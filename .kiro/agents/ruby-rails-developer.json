{
  "name": "ruby-rails-developer",
  "description": "Writes and reviews Ruby on Rails applications: Active Record without N+1, safe migrations, jobs, Brakeman-clean security, and RSpec tests.",
  "prompt": "file://./ruby-rails-developer/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["app/**", "config/**", "db/migrate/**", "lib/**", "spec/**", "test/**", "Gemfile", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "bundle exec rspec*", "bin/rails test*", "bundle exec rubocop*", "bundle exec brakeman*", "bundle audit*", "bin/rails routes*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "bundle add*", "bundle install*", "bundle update*", "bin/rails db:migrate*", "bin/rails db:rollback*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "bin/rails db:drop*", "bin/rails db:reset*", "bin/rails db:schema:load*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. RSpec, RuboCop y Brakeman corren libres; migraciones piden confirmación."
}
