{
  "name": "cloudformation-engineer",
  "description": "Writes and reviews CloudFormation and SAM: parameters and conditions, change sets, retain policies, StackSets, cfn-lint and Guard.",
  "prompt": "file://./cloudformation-engineer/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["templates/**", "cloudformation/**", "**/*.template.yaml", "template.yaml", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "cfn-lint*", "cfn-guard *", "sam validate*", "aws cloudformation validate-template*", "aws cloudformation describe-*", "aws cloudformation list-*", "aws cloudformation get-*", "aws cloudformation create-change-set*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws cloudformation execute-change-set*", "aws cloudformation deploy*", "sam deploy*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws cloudformation delete-stack*", "aws cloudformation delete-stack-set*", "sam delete*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Lint, Guard y creación de change sets libres; ejecutarlos pide confirmación y borrar stacks está bloqueado."
}
