{
  "name": "disaster-recovery",
  "description": "Designs disaster recovery and business continuity: RTO/RPO per process, DR strategies, ransomware-resilient backups, failover, and recovery testing.",
  "prompt": "file://./disaster-recovery/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["docs/**", "runbooks/**", "infra/**", "terraform/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws backup list-*", "aws backup describe-*", "aws backup get-*", "aws drs describe-*", "aws route53-recovery-readiness get-*", "aws rds describe-*", "aws dynamodb describe-*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws backup start-restore-job*", "aws backup start-backup-job*", "aws drs start-recovery*", "aws route53-recovery-cluster update-routing-control-state*", "aws rds failover-*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws backup delete-*", "aws drs delete-*", "aws rds delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Un backup que nunca se restauró no cuenta: diseñamos y probamos la recuperación. Los failover piden confirmación."
}
