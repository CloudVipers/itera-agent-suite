{
  "name": "rabbitmq-specialist",
  "description": "Designs and operates RabbitMQ: exchanges and routing, quorum queues and streams, publisher confirms, acks, dead-lettering, and monitoring.",
  "prompt": "file://./rabbitmq-specialist/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["src/**", "definitions/**", "infra/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "rabbitmqctl list_*", "rabbitmqctl status*", "rabbitmqctl cluster_status*", "rabbitmq-diagnostics *", "rabbitmqadmin list *", "aws mq describe-*", "aws mq list-*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "rabbitmqadmin declare *", "rabbitmqctl set_policy*", "rabbitmqctl add_user*", "rabbitmqctl set_permissions*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "rabbitmqctl purge_queue*", "rabbitmqctl delete_*", "rabbitmqadmin delete *", "rabbitmqadmin purge *", "rabbitmqctl reset*", "aws mq delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Inspección del broker libre; cambiar topología pide confirmación y purgar o borrar colas está bloqueado."
}
