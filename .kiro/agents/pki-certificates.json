{
  "name": "pki-certificates",
  "description": "Manages PKI and TLS: certificate inventory, automated renewal, CA hierarchies, TLS/mTLS configuration, and expiry monitoring.",
  "prompt": "file://./pki-certificates/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["infra/**", "k8s/**", "docs/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "openssl s_client*", "openssl x509*", "openssl verify*", "testssl*", "aws acm list-*", "aws acm describe-*", "aws acm-pca list-*", "aws acm-pca describe-*", "kubectl get certificate*", "kubectl describe certificate*", "kubectl get *", "kubectl describe *", "kubectl top *", "kubectl explain *", "kubectl auth can-i*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws acm request-certificate*", "aws acm-pca issue-certificate*", "aws acm-pca revoke-certificate*", "certbot *", "cmctl renew*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws acm delete-certificate*", "aws acm-pca delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Inventario y revisión de certificados y TLS; emitir o revocar certificados pide confirmación."
}
