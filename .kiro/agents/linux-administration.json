{
  "name": "linux-administration",
  "description": "Administers, troubleshoots, and hardens Linux servers: systemd, performance diagnostics, CIS hardening, SSH/SSM access, and Ansible automation.",
  "prompt": "file://./linux-administration/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["ansible/**", "playbooks/**", "roles/**", "scripts/**", "docs/**", "runbooks/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "uptime*", "vmstat *", "iostat *", "mpstat *", "pidstat *", "free *", "df *", "du -sh *", "ss -*", "ip a*", "ip r*", "journalctl *", "systemctl status *", "systemctl list-*", "dmesg*", "lsblk*", "ansible-lint*", "ansible-playbook * --check*", "ansible-inventory --list*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "systemctl restart *", "systemctl stop *", "systemctl enable *", "ansible-playbook *", "kill *"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Diagnóstico con comandos de solo lectura; todo cambio al sistema pide confirmación y sudo está bloqueado."
}
