{
  "name": "docker-engineering",
  "description": "Writes and reviews Dockerfiles, Compose files, and image builds: multi-stage, BuildKit caching and secrets, multi-arch with buildx, and runtime hardening.",
  "prompt": "file://./docker-engineering/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["**/Dockerfile*", "**/.dockerignore", "**/docker-compose*.yml", "**/compose*.yaml", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "hadolint*", "docker images*", "docker inspect *", "docker history *", "dive *", "trivy image*", "trivy fs*", "docker buildx ls*", "docker compose config*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "docker build*", "docker buildx build*", "docker compose up*", "docker compose down*", "docker run*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "docker rm -f*", "docker volume rm*", "docker compose down -v*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Lint y análisis de imágenes libres; construir pide confirmación y publicar imágenes está bloqueado."
}
