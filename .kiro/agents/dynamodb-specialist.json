{
  "name": "dynamodb-specialist",
  "description": "Amazon DynamoDB specialist: access-pattern-first key design, single-table design, GSIs, conditional writes, capacity modes, and hot partitions.",
  "prompt": "file://./dynamodb-specialist/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["migrations/**", "**/migrations/**", "db/**", "sql/**", "schema/**", "docs/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws dynamodb describe-*", "aws dynamodb list-*", "aws cloudwatch get-metric-data*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws dynamodb query*", "aws dynamodb get-item*", "aws dynamodb put-item*", "aws dynamodb update-*", "aws dynamodb create-table*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "DROP DATABASE*", "dropdb *", "* DROP DATABASE*", "* drop database*", "* TRUNCATE *", "* truncate *", "aws dynamodb delete-*", "aws dynamodb scan*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Diseño de llaves desde los patrones de acceso; escribir datos pide confirmación."
}
