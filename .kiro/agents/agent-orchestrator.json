{
  "name": "agent-orchestrator",
  "description": "Orchestrates the ITera Agent Suite: decomposes any development request, routes each task to the right specialist agent, and consolidates the results.",
  "prompt": "file://./agent-orchestrator/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web",
    "subagent"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["docs/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"},
      {"capability": "subagent", "match": ["3d-modeling", "accessibility", "active-directory", "ai-agent-developer", "ai-governance", "ai-llm-security", "analytics-bi", "android-developer", "angular-developer", "ansible-automation", "api-design", "api-security-testing", "api-testing", "audio-engineering", "aws-best-practices", "aws-cdk-engineer", "aws-cloudwatch", "aws-ecs-fargate", "aws-landing-zone", "aws-messaging", "aws-migration-map", "aws-networking", "aws-organizations-iam", "aws-serverless", "azure-architect", "azure-entra-iam", "azure-functions", "backend-engineering", "blockchain-architecture", "blockchain-protocol-engineer", "business-process-analyst", "capacity-planning", "chaos-engineering", "cloud-cost-forecasting", "cloud-security", "cloudformation-engineer", "code-reviewer", "colombia-financial-regulation", "colombian-labor-law", "commitment-management", "container-best-practices", "container-reviewer", "cpp-developer", "cryptography-encryption", "dapp-web3-developer", "dast-security", "data-engineering", "data-governance", "data-scientist", "data-warehouse", "database-engineering", "database-migration", "debugging-troubleshooting", "detection-engineering", "dev-best-practices", "dev-documentation", "devops-reviewer", "devsecops-reviewer", "disaster-recovery", "docker-engineering", "dotnet-developer", "dynamodb-specialist", "engineering-manager", "enterprise-architecture", "event-driven-architecture", "finops-cost-optimization", "flutter-developer", "frontend-engineering", "game-audio-designer", "game-designer", "gcp-architect", "gcp-iam", "gcp-serverless", "genai-aws-practices", "genai-finops", "github-actions-cicd", "gitlab-cicd", "gitops-argocd", "go-developer", "graphql-api", "iac-reviewer", "ibm-cloud-architect", "identity-federation-sso", "identity-governance", "incident-management-oncall", "incident-response", "ios-developer", "iso27001-isms", "java-spring-developer", "kafka-streaming", "kubernetes-best-practices", "kubernetes-finops", "kubernetes-security", "learning-development", "least-privilege", "linux-administration", "linux-security-hardening", "machine-learning-engineer", "mainframe-modernization", "microservices-architecture", "mlops-engineering", "mobile-engineering", "mobile-test-automation", "mongodb-specialist", "multi-cloud-strategy", "multicloud-iam", "network-security", "nextjs-developer", "observability-sre", "oci-architect", "open-source-licensing", "opentelemetry", "oracle-database", "patch-management", "pci-dss-compliance", "pentest-security", "people-operations", "performance-engineering", "php-laravel-developer", "pki-certificates", "platform-engineering", "policy-as-code", "postgresql-specialist", "presales-solutions-architect", "privacy-compliance", "product-owner", "project-manager", "prometheus-grafana", "python-developer", "qa-lead", "qa-manual-testing", "rabbitmq-specialist", "react-developer", "react-native-developer", "redis-specialist", "refactoring-modernization", "release-management", "requirements-analyst", "ruby-rails-developer", "rust-developer", "sast-security", "sca-security", "scrum-master", "secrets-management", "secure-development", "security-audit", "security-tester", "shell-scripting-automation", "smart-contract-engineer", "smart-contract-security", "software-architect", "software-estimation", "sql-server-dba", "supply-chain-security", "tagging-governance", "tech-contracts-legal", "tech-lead", "technical-artist", "technical-recruiter", "technical-specification-writer", "technology-strategy", "terraform-engineer", "test-automation", "threat-modeling", "typescript-node-developer", "ui-ux-design", "unity-game-developer", "unreal-engine-developer", "vue-developer", "vulnerability-management", "waf-ddos-protection", "web-e2e-automation", "windows-server", "yaml-best-practices"], "effect": "allow"}
    ]
  },
  "welcomeMessage": "Listo. Cuéntame el objetivo y armo el plan con los agentes adecuados."
}
