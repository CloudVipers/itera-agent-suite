{
  "name": "agent-orchestrator",
  "description": "Orchestrates the ITera Agent Suite: decomposes any development request, routes each task to the right specialist agent, and consolidates the results.",
  "prompt": "file://./agent-orchestrator/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web",
    "subagent"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["docs/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"},
      {"capability": "subagent", "match": ["accessibility", "ai-agent-developer", "ai-llm-security", "analytics-bi", "api-design", "api-testing", "aws-best-practices", "aws-landing-zone", "aws-migration-map", "aws-networking", "aws-organizations-iam", "aws-serverless", "azure-architect", "blockchain-architecture", "cloud-cost-forecasting", "cloud-security", "code-reviewer", "commitment-management", "container-best-practices", "container-reviewer", "cryptography-encryption", "dast-security", "data-engineering", "database-engineering", "debugging-troubleshooting", "detection-engineering", "dev-best-practices", "dev-documentation", "devops-reviewer", "devsecops-reviewer", "disaster-recovery", "dotnet-developer", "engineering-manager", "enterprise-architecture", "event-driven-architecture", "finops-cost-optimization", "frontend-engineering", "gcp-architect", "genai-aws-practices", "genai-finops", "go-developer", "iac-reviewer", "ibm-cloud-architect", "identity-federation-sso", "identity-governance", "incident-response", "java-spring-developer", "kubernetes-best-practices", "kubernetes-finops", "kubernetes-security", "least-privilege", "linux-administration", "microservices-architecture", "mlops-engineering", "mobile-engineering", "mobile-test-automation", "multi-cloud-strategy", "network-security", "observability-sre", "oci-architect", "pentest-security", "performance-engineering", "pki-certificates", "platform-engineering", "presales-solutions-architect", "privacy-compliance", "product-owner", "project-manager", "python-developer", "qa-lead", "qa-manual-testing", "refactoring-modernization", "release-management", "requirements-analyst", "sast-security", "scrum-master", "secrets-management", "secure-development", "security-audit", "security-tester", "shell-scripting-automation", "smart-contract-security", "software-architect", "software-estimation", "supply-chain-security", "tagging-governance", "tech-lead", "technology-strategy", "test-automation", "threat-modeling", "typescript-node-developer", "ui-ux-design", "vulnerability-management", "waf-ddos-protection", "web-e2e-automation", "yaml-best-practices"], "effect": "allow"}
    ]
  },
  "welcomeMessage": "Listo. Cuéntame el objetivo y armo el plan con los agentes adecuados."
}
