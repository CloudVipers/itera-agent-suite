{
  "name": "aws-messaging",
  "description": "Chooses and configures AWS messaging: SQS (standard/FIFO), SNS, EventBridge, Kinesis, Amazon MQ, and MSK with DLQs, idempotency, and security.",
  "prompt": "file://./aws-messaging/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["infra/**", "terraform/**", "lib/**", "src/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws sqs get-queue-attributes*", "aws sqs list-*", "aws sns list-*", "aws sns get-*", "aws events list-*", "aws events describe-*", "aws kinesis describe-*", "aws kinesis list-*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws sqs send-message*", "aws sns publish*", "aws events put-events*", "aws sqs set-queue-attributes*", "aws events put-rule*", "aws sqs start-message-move-task*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws sqs purge-queue*", "aws sqs delete-*", "aws sns delete-*", "aws events delete-*", "aws kinesis delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Lectura de colas y buses libre; enviar mensajes o cambiar configuración pide confirmación."
}
