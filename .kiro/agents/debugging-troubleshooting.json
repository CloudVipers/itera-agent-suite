{
  "name": "debugging-troubleshooting",
  "description": "Finds root causes of errors, stack traces, failing tests, and production issues with a systematic, evidence-based method.",
  "prompt": "file://./debugging-troubleshooting/agent.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["src/**", "lib/**", "app/**", "tests/**", "test/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "git bisect*", "git reflog*", "kubectl logs *", "docker ps*", "docker logs *", "docker inspect *", "dig *", "nslookup *", "openssl s_client*", "aws logs filter-log-events*", "aws logs get-log-events*", "aws logs start-query*", "aws logs get-query-results*", "aws cloudtrail lookup-events*", "kubectl get *", "kubectl describe *", "kubectl top *", "kubectl explain *", "kubectl auth can-i*", "npm run lint*", "npm run test*", "npm test*", "npm run build*", "npm run typecheck*", "npx tsc*", "npx eslint*", "npx vitest*", "npx jest*", "pnpm lint*", "pnpm test*", "pnpm build*", "yarn lint*", "yarn test*", "yarn build*", "pytest*", "python -m pytest*", "ruff check*", "mypy *", "go test*", "go vet*", "mvn test*", "mvn verify*", "./gradlew test*", "dotnet test*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "kubectl exec *", "docker exec *", "kubectl rollout restart*", "curl *"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Pégame el error completo, el stack trace o los logs y buscamos la causa raíz."
}
