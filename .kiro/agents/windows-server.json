{
  "name": "windows-server",
  "description": "Administers and hardens Windows Server: PowerShell automation, IIS, Group Policy baselines, updates, clustering, and EC2/Azure specifics.",
  "prompt": "file://./windows-server/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["scripts/**", "dsc/**", "gpo/**", "docs/**", "runbooks/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "Invoke-ScriptAnalyzer*", "Get-*", "aws ssm describe-*", "aws ssm list-*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "Set-*", "Install-*", "Enable-*", "Disable-*", "Restart-*", "Invoke-Command*", "aws ssm send-command*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "Remove-*", "Format-*", "Clear-*", "Stop-Computer*", "Restart-Computer*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Diagnóstico en modo lectura; los cambios se entregan como scripts con -WhatIf para que los ejecutes tú."
}
