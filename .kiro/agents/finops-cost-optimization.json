{
  "name": "finops-cost-optimization",
  "description": "Finds cloud cost savings: cost visibility and tagging, right-sizing, Savings Plans, waste removal, and cost-aware design.",
  "prompt": "file://./finops-cost-optimization/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["reports/**", "docs/**", "infra/**", "terraform/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws ce get-*", "aws compute-optimizer get-*", "aws budgets describe-*", "aws pricing get-*", "aws cloudwatch get-metric-statistics*", "aws cloudwatch get-metric-data*", "infracost *", "aws * describe-*", "aws * list-*", "aws * get-*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws * modify-*", "aws * stop-*", "aws * put-*", "aws * create-*", "aws * update-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Solo lectura de costos y uso; ningún recurso se modifica desde aquí."
}
