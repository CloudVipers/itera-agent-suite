{
  "name": "detection-engineering",
  "description": "Builds security detections as code (Sigma, KQL, SPL, CloudWatch Logs Insights) mapped to MITRE ATT&CK, tested with attack simulation and tuned for low noise.",
  "prompt": "file://./detection-engineering/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["detections/**", "rules/**", "sigma/**", "docs/**", "reports/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "sigma check*", "sigma convert*", "aws logs start-query*", "aws logs get-query-results*", "aws cloudtrail lookup-events*", "aws guardduty list-*", "aws guardduty get-*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "stratus *", "atomic-red-team*", "Invoke-AtomicTest*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Detecciones como código, mapeadas a ATT&CK y probadas; las simulaciones de ataque piden confirmación."
}
