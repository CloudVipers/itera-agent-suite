{
  "name": "aws-cloudwatch",
  "description": "Designs AWS observability with CloudWatch: metrics and percentile alarms, Logs Insights, retention, X-Ray/Application Signals, canaries, and cost.",
  "prompt": "file://./aws-cloudwatch/agent.md",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {"capability": "fs_write", "match": ["infra/**", "monitoring/**", "dashboards/**", "docs/**"], "effect": "allow"},
      {"capability": "fs_read", "match": ["**/.env", "**/.env.*", "~/.aws/**", "**/.aws/**", "~/.ssh/**", "**/.ssh/**", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_ed25519*", "**/*.tfstate", "**/*.tfstate.*", "**/credentials.json", "**/*.p12", "**/*.pfx"], "exclude": ["**/.env.example", "**/.env.sample", "**/.env.template"], "effect": "deny"},
      {"capability": "shell", "match": ["git status*", "git diff*", "git log*", "git show*", "git blame*", "git branch*", "git ls-files*", "git grep *", "aws cloudwatch describe-*", "aws cloudwatch get-*", "aws cloudwatch list-*", "aws logs describe-*", "aws logs start-query*", "aws logs get-query-results*", "aws xray get-*", "aws synthetics describe-*", "terraform fmt -check*", "terraform validate*", "terraform plan*"], "effect": "allow"},
      {"capability": "shell", "match": ["git add*", "git commit*", "git checkout *", "git switch *", "git stash*", "git merge*", "git rebase*", "git push*", "aws cloudwatch put-metric-alarm*", "aws logs put-retention-policy*", "aws cloudwatch put-dashboard*"], "effect": "ask"},
      {"capability": "shell", "match": ["rm -rf *", "sudo *", "chmod -R 777*", "curl * | sh*", "curl * | bash*", "wget * | sh*", "terraform apply*", "terraform destroy*", "terraform import*", "terraform state rm*", "kubectl delete *", "kubectl get secret*", "kubectl describe secret*", "helm uninstall*", "git push --force*", "git push -f*", "git reset --hard*", "git clean -f*", "aws * delete-*", "aws * terminate-*", "aws s3 rm*", "aws s3 rb*", "aws secretsmanager get-secret-value*", "aws ssm get-parameter*", "docker push*", "docker system prune*", "npm publish*", "aws cloudwatch delete-*", "aws logs delete-*"], "effect": "deny"}
    ]
  },
  "welcomeMessage": "Listo. Consultas de métricas y logs libres; crear o borrar alarmas pide confirmación o está bloqueado."
}
